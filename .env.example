# MongoDB Atlas connection string (free M0 cluster works)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=ridgeline

# Public URL of the deployed app (used in QR passes and emails)
APP_URL=http://localhost:3000

# Staff dashboard login
ADMIN_PASSWORD=change-me
AUTH_SECRET=a-long-random-string-at-least-32-characters

# Optional: SMTP for confirmation + reminder emails (Gmail app password works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ridgeline Motor Park <bookings@example.com>"

# Protects the reminder cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=another-random-string
